# Configuración del Bot de Copy Trading - Polymarket

# ===== BILLETERAS Y CREDENCIALES =====
# Dirección del trader que quieres copiar (address de Polymarket)
TARGET_TRADER_ADDRESS=0x...

# Tu dirección de Polymarket (funder address)
YOUR_POLYMARKET_ADDRESS=0x...

# Tu clave privada (MANTÉN ESTO SEGURO - NUNCA COMPARTAS)
YOUR_PRIVATE_KEY=0x...

# ===== CONFIGURACIÓN DE POLYMARKET =====
# URL del CLOB (Central Limit Order Book)
CLOB_URL=https://clob.polymarket.com
CLOB_CHAIN_ID=137

# URL de la API Gamma (información de mercados)
GAMMA_API_URL=https://gamma-api.polymarket.com

# ===== PARÁMETROS DE TRADING =====
# Porcentaje del tamaño de la orden del trader a copiar (0.1 = 10%, 1.0 = 100%, 2.0 = 200%)
COPY_SIZE_MULTIPLIER=1.0

# Tamaño mínimo de orden para copiar (en USDC)
MIN_ORDER_SIZE=1

# Tamaño máximo de orden a copiar (en USDC) - protección de riesgo
MAX_ORDER_SIZE=1000

# Slippage máximo permitido (0.01 = 1%)
MAX_SLIPPAGE=0.02

# ===== CONFIGURACIÓN DE MONITOREO =====
# Intervalo de polling para nuevas trades (en milisegundos)
POLL_INTERVAL=5000

# Tiempo máximo de antigüedad para considerar un trade (en minutos)
MAX_TRADE_AGE_MINUTES=5

# ===== CONFIGURACIÓN DE REINTENTOS =====
# Número máximo de reintentos para una orden fallida
MAX_RETRIES=3

# Delay entre reintentos (en milisegundos)
RETRY_DELAY=2000

# ===== MODO DE OPERACIÓN =====
# Modo dry-run: true = solo simula, false = ejecuta trades reales
DRY_RUN=true

# Nivel de logging: debug, info, warn, error
LOG_LEVEL=info

# ===== FILTROS AVANZADOS (OPCIONAL) =====
# Lista de IDs de mercados para ignorar (separados por coma)
# BLACKLIST_MARKETS=market_id_1,market_id_2

# Lista de IDs de mercados para copiar exclusivamente (separados por coma)
# WHITELIST_MARKETS=market_id_1,market_id_2

# Copiar solo operaciones BUY, SELL, o ambas (BUY,SELL)
COPY_SIDES=BUY,SELL
